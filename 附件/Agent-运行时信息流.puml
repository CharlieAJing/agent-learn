@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "PingFang SC"
skinparam defaultFontColor #21394B
skinparam defaultTextAlignment center
skinparam componentStyle rectangle
skinparam componentBorderColor #A6BDCC
skinparam componentBackgroundColor #F6F9FB
skinparam ArrowColor #698698
skinparam ArrowFontColor #486477
skinparam ArrowFontSize 14
skinparam shadowing false
skinparam roundcorner 14
skinparam padding 10
skinparam nodesep 34
skinparam ranksep 34
skinparam dpi 180

component "<size:19><b>运行程序</b></size>\n组装上下文，检查调用权限\n维护任务状态，按需读取长期记忆" as Runtime #E6F1F8
component "<size:19><b>模型</b></size>\n根据上下文决定下一步\n返回答复或工具请求" as Model
component "<size:19><b>工具</b></size>\n按参数执行操作\n返回结果或错误" as Tool

Runtime --> Model : 提供上下文
Runtime --> Tool : 发起获准的调用
Model -[hidden]right-> Tool
@enduml
