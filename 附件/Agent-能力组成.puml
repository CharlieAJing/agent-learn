@startuml
!pragma layout smetana
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 17
skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 165
skinparam ArrowColor #526C80
skinparam rectangleBorderColor #93AABC
skinparam rectangleBackgroundColor #F5F8FA
skinparam roundcorner 12
skinparam nodesep 28
skinparam ranksep 30
rectangle "模型\n决策核心" as Model #E6F1FC
rectangle "规划\n分解目标、调整步骤" as Plan
rectangle "记忆\n保留与取回信息" as Memory
rectangle "工具使用\n选择操作、利用结果" as ToolUse
Model -- Plan
Model -- Memory
Model -- ToolUse
Plan -[hidden]right-> Memory
Memory -[hidden]right-> ToolUse
@enduml
