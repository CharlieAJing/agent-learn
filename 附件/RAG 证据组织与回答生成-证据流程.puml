@startuml
skinparam defaultFontName PingFang SC
skinparam defaultFontSize 15
skinparam shadowing false
skinparam activityBackgroundColor #EEF4FA
skinparam activityBorderColor #58728D
start
:① 明确问题边界;
if (必须由用户消除歧义？) then (是)
 :提出必要澄清;
 stop
else (否)
endif
repeat
 :② 整理候选证据;
 :③ 组装证据包;
 :④ 生成候选回答;
 :⑤ 核验已有结果;
 if (完整回答通过？) then (是)
  :交付完整回答;
  stop
 else (否)
 endif
 :⑥ 判断缺口与剩余预算;
 if (需要用户确定范围？) then (是)
  :提出必要澄清;
  stop
 else (否)
 endif
 if (仍有预算且缺口可修复？) then (是)
  if (缺少可查证据？) then (是)
   :提交补查需求给检索规划;
   :接收返回材料并检查新增信息;
  else (否)
   :标记已有证据支持的改写要求;
  endif
 else (否)
  :交付已核验部分或说明无法作答;
  stop
 endif
repeat while (有新增信息或可执行改写？) is (是) not (否)
:交付已核验部分或说明无法作答;
stop
@enduml
